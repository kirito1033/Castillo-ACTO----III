  #${id}.dh-animacion .dh-caja{padding:18px 23px;background:#28444ced}
  #${id} h2{font:clamp(25px,4vw,34px) Georgia,serif;color:#ffebc5;margin:0 70px 12px 0}
  #${id} p{margin:10px 0}
